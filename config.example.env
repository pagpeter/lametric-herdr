# Copy to "$(herdr plugin config-dir lametric-herdr)/.env"

# Device IP and API key (developer.lametric.com -> Devices)
LAMETRIC_HOST=
LAMETRIC_API_KEY=

# Statuses that trigger a one-shot silent notification (empty disables alerts)
ALERT_ON=blocked,done
# info | warning | critical
ALERT_PRIORITY=info
# How many times the notification scrolls before returning to the clock
ALERT_CYCLES=1

# Seconds between polls of each saved herdr machine (default 2)
REMOTE_POLL_SECONDS=
