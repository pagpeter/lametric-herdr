# Copy to "$(herdr plugin config-dir lametric-herdr)/.env"

# Device IP and API key (developer.lametric.com -> Devices)
LAMETRIC_HOST=192.168.0.102
LAMETRIC_API_KEY=

# Local push URL shown in the "My Data DIY" app settings on the device
LAMETRIC_PUSH_URL=

# Statuses that trigger a one-shot silent notification
ALERT_ON=blocked,done
# info | warning | critical
ALERT_PRIORITY=info
# How many times the notification scrolls before returning to the widget
ALERT_CYCLES=1

# Log events and rendered widget text to the plugin state dir (debug.jsonl)
DEBUG=0
